# Django
SECRET_KEY=django-insecure-54+)v1ruxn%%u0_!j%p3!i#fjyk5%18lh&cphvrgw-1sh_lh*s
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,projeto-loja-uqac.onrender.com

# Database (SQLite - padrão local)
# Para usar PostgreSQL, use: postgresql://user:password@localhost:5432/projeto_loja
