# CORS (origens permitidas para o frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://projeto-loja-uol4.vercel.app

# Opcional para testes rápidos (NÃO usar em produção)
CORS_ALLOW_ALL_ORIGINS=False

# CSRF para frontend em produção e ambiente local
CSRF_TRUSTED_ORIGINS=https://projeto-loja-uol4.vercel.app,https://projeto-loja-uqac.onrender.com,http://localhost:5173

# URL pública do backend para webhooks de produção
WEBHOOK_URL=https://projeto-loja-uqac.onrender.com/api/pagamentos/webhook/

# Email (Opcional - para notificações)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_app_gmail
