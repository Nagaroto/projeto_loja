# ============================================
# CONFIGURAÇÕES DE AMBIENTE - PROJETO LOJA
# ============================================
# Copie este arquivo para .env e preencha com seus valores reais
# IMPORTANTE: Nunca commitar o arquivo .env real com valores sensíveis

# Django
# Gere uma chave segura: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=gerar_uma_chave_secreta_aqui_e_nao_usar_essa
DEBUG=False
ALLOWED_HOSTS=.onrender.com,.vercel.app

# Database (PostgreSQL recomendado para produção)
# Formato: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# Backend URL para geração de URLs de mídia em produção
BACKEND_URL=https://projeto-loja-uqac.onrender.com

# Mercado Pago API
# Obtenha em: https://www.mercadopago.com.br/developers/panel
MERCADO_PAGO_ACCESS_TOKEN=seu_token_aqui
MERCADO_PAGO_PUBLIC_KEY=sua_chave_publica_aqui

# CORS (origens permitidas para o frontend)
CORS_ALLOWED_ORIGINS=https://projeto-loja-uol4.vercel.app,https://projeto-loja-uqac.onrender.com

# Opcional para testes rápidos (NÃO usar em produção)
CORS_ALLOW_ALL_ORIGINS=False

# CSRF para frontend em produção
CSRF_TRUSTED_ORIGINS=https://projeto-loja-uol4.vercel.app,https://projeto-loja-uqac.onrender.com

# URL pública do backend para webhooks de produção
WEBHOOK_URL=https://projeto-loja-uqac.onrender.com/api/pagamentos/webhook/

# AWS S3 (para arquivos estáticos e mídia em produção)
AWS_STORAGE_BUCKET_NAME=seu_bucket_s3
AWS_ACCESS_KEY_ID=sua_access_key
AWS_SECRET_ACCESS_KEY=sua_secret_key
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=seu_dominio_cloudfront

# Email (Opcional - para notificações)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_app_gmail

# PIX Configuration
PIX_EXPIRACAO_MINUTOS=15

# Logging
LOG_LEVEL=INFO
